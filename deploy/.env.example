# Copy to deploy/.env to override the compose defaults.
# Values here mirror scripts/setup-dbs.sh so native and container setups
# stay in sync.

# Port mappings for the target databases on the docker host.
PG_PORT=5432
MYSQL_PORT=3306

# Database credentials (TEST ONLY - never reuse outside a lab).
POSTGRES_PASSWORD=dbguard
MYSQL_ROOT_PASSWORD=dbguard

# Bearer token expected by the DBGuard admin API; used by
# scripts/load-policy.sh when triggering /api/v1/policies/reload.
DBGUARD_API_TOKEN=changeme

# Log level override consumed by the daemon (DBGUARD_LOG_LEVEL).
DBGUARD_LOG_LEVEL=info

COMPOSE_PROJECT_NAME=dbguard
